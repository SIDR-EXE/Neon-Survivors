{
  "name": "game",
  "version": "1.0.0",
  "description": "A retro pixel art horde survival game inspired by Vampire Survivors. Survive endless waves of enemies, collect weapons, and level up!",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.neon.survivors",
    "productName": "Neon Survivors",
    "win": {
      "target": "nsis"
    }
  },
  "devDependencies": {
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3"
  }
}
